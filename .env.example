# FlowForge Configuration
APP_ENV=dev
LOG_LEVEL=INFO
API_CORS_ORIGINS=http://localhost:5173
MAX_REQUEST_BYTES=1048576

# Database & Authentication
DATABASE_URL=postgresql+asyncpg://flowforge:flowforge@localhost:5432/flowforge
JWT_SECRET=change-me-to-a-random-string-of-32-chars-or-more

# Worker & Messaging
RABBITMQ_URL=amqp://flowforge:flowforge@localhost:5672//
CELERY_TASK_QUEUE=runs.execute

# Egress & Secrets
EGRESS_BLOCK_PRIVATE=true
SECRETS_MASTER_KEYS=k1:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
