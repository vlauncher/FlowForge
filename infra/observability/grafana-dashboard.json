  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "title": "HTTP Request Rate by Route",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(flowforge_http_requests_total[1m])) by (route_template, method)",
          "legendFormat": "{{method}} {{route_template}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "id": 2,
      "title": "Queue Lag: Oldest Queued Run Age (Seconds)",
      "type": "stat",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "flowforge_oldest_queued_run_age_seconds",
          "legendFormat": "Age"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 3,
      "title": "Terminal Workflow Runs",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(flowforge_runs_total[5m])) by (state)",
          "legendFormat": "{{state}}"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 4,
      "title": "Outbox Unpublished Count",
      "type": "gauge",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "flowforge_outbox_unpublished_count",
          "legendFormat": "Unpublished Events"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "id": 5,
      "title": "Step Execution Rate by Step Type",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(flowforge_step_attempts_total[1m])) by (step_type, status)",
          "legendFormat": "{{step_type}} ({{status}})"
        }
      ]
    },
    {
      "collapsed": false,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "id": 6,
      "title": "LLM Tokens Consumed by Model",
      "type": "timeseries",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(flowforge_llm_tokens_total[5m])) by (model, token_type)",
          "legendFormat": "{{model}} - {{token_type}}"
        }
      ]
    }
  ],
